# Plantilla de configuración del backend.
# Copiá este archivo como .env y completá los valores con los de tu máquina.
# El .env no se versiona (está en .gitignore) porque tiene credenciales.

# Conexión a MySQL. La usan tanto el servidor como el CLI de Prisma para las
# migraciones. Reemplazá usuario y contrasena por los de tu servidor MySQL.
DATABASE_URL=mysql://usuario:contrasena@localhost:3306/sportsbook

# Puerto en el que escucha la API. Opcional: si no está, se usa 3000.
PORT=3000

# Secreto con el que se firman los tokens de sesión. Es lo único que distingue
# un token legítimo de uno fabricado, así que tiene que ser largo, aleatorio y
# distinto en cada ambiente. Generá el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-valor-aleatorio-de-al-menos-32-caracteres

# Cuánto dura la sesión antes de tener que volver a iniciarla. Opcional: si no
# está, se usan 8 horas. Formato: "30m", "8h", "7d".
JWT_EXPIRACION=8h

# Administrador inicial que crea "npm run seed". Sin él, una base recién migrada
# no tiene ninguna cuenta con la que entrar a la aplicación. Solo lo usa el seed:
# el servidor arranca igual sin estas dos variables.
ADMIN_EMAIL=admin@sportbook.com
ADMIN_CONTRASENA=cambiame
