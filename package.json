{
  "name": "sportbook-backend",
  "version": "1.0.0",
  "description": "API REST de SportBook, una aplicación para gestionar reservas de canchas deportivas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --require ./tests/apoyo/ambiente.js --test \"tests/unitarios/*.test.js\"",
    "test:preparar": "node tests/apoyo/preparar-base.js",
    "test:integracion": "node --require ./tests/apoyo/ambiente.js --test-concurrency=1 --test \"tests/integracion/*.test.js\"",
    "test:todo": "npm test && npm run test:integracion"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanifaccio/SportBook-BackEnd.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/juanifaccio/SportBook-BackEnd/issues"
  },
  "homepage": "https://github.com/juanifaccio/SportBook-BackEnd#readme",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.3",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
