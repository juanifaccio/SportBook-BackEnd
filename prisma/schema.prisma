generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model TipoCancha {
  id          Int    @id @default(autoincrement())
  nombre      String @unique
  descripcion String

  canchas Cancha[]
}

enum EstadoCancha {
  DISPONIBLE
  MANTENIMIENTO
}

model Cancha {
  id            Int          @id @default(autoincrement())
  nombre        String       @unique
  precioPorHora Decimal      @db.Decimal(10, 2)
  estado        EstadoCancha

  tipoCanchaId Int
  tipoCancha   TipoCancha @relation(fields: [tipoCanchaId], references: [id])

  horarios Horario[]
  reservas Reserva[]
}

model Horario {
  id         Int      @id @default(autoincrement())
  fecha      DateTime @db.Date
  horaInicio String   @db.VarChar(5)
  horaFin    String   @db.VarChar(5)
  disponible Boolean  @default(true)

  canchaId Int
  cancha   Cancha @relation(fields: [canchaId], references: [id])

  reservas Reserva[]

  @@unique([canchaId, fecha, horaInicio])
}

model Rol {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  usuarios Usuario[]
}

model Usuario {
  id         Int     @id @default(autoincrement())
  nombre     String
  email      String  @unique
  contrasena String
  telefono   String  @db.VarChar(20)
  activo     Boolean @default(true)

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  reservas Reserva[]
}

model TipoEvento {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  eventos Evento[]
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

model Reserva {
  id          Int           @id @default(autoincrement())
  fecha       DateTime      @db.Date
  horaInicio  String        @db.VarChar(5)
  horaFin     String        @db.VarChar(5)
  estado      EstadoReserva
  precioTotal Decimal       @db.Decimal(10, 2)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  canchaId Int
  cancha   Cancha @relation(fields: [canchaId], references: [id])

  horarioId Int
  horario   Horario @relation(fields: [horarioId], references: [id])

  evento Evento?

  pagos Pago[]

  equipamientos ReservaEquipamiento[]
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum EstadoPago {
  REGISTRADO
  ANULADO
}

model Pago {
  id     Int        @id @default(autoincrement())
  monto  Decimal    @db.Decimal(10, 2)
  fecha  DateTime   @db.Date
  metodo MetodoPago
  estado EstadoPago

  reservaId Int
  reserva   Reserva @relation(fields: [reservaId], references: [id])
}

model Evento {
  id               Int    @id @default(autoincrement())
  descripcion      String
  cantidadPersonas Int

  tipoEventoId Int
  tipoEvento   TipoEvento @relation(fields: [tipoEventoId], references: [id])

  reservaId Int     @unique
  reserva   Reserva @relation(fields: [reservaId], references: [id])
}

model Equipamiento {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String
  precio      Decimal @db.Decimal(10, 2)
  stock       Int

  reservas ReservaEquipamiento[]
}

model ReservaEquipamiento {
  id       Int     @id @default(autoincrement())
  cantidad Int
  subtotal Decimal @db.Decimal(10, 2)

  reservaId Int
  reserva   Reserva @relation(fields: [reservaId], references: [id])

  equipamientoId Int
  equipamiento   Equipamiento @relation(fields: [equipamientoId], references: [id])

  @@unique([reservaId, equipamientoId])
}
