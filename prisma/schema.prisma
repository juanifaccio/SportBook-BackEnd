// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model TipoCancha {
  id Int @id @default(autoincrement())
  // Es un catálogo: dos filas "Fútbol 5" partirían las canchas entre dos ids
  // que significan lo mismo, y el listado filtrado por tipo mostraría la opción
  // repetida con resultados incompletos.
  nombre      String @unique
  descripcion String
}

model TipoEvento {
  id     Int    @id @default(autoincrement())
  // Es un catálogo: un nombre repetido no clasifica nada y partiría los eventos
  // entre dos ids que significan lo mismo.
  nombre String @unique
}