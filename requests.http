# Toda la API pide sesión menos el login. Ejecutá primero "Iniciar sesión": las
# peticiones de abajo toman el token de su respuesta con {{login.response.body.token}}.

### Iniciar sesión
# @name login
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
    "email": "admin@sportbook.com",
    "contrasena": "cambiame"
}

### Ver el usuario de la sesión
GET http://localhost:3000/api/auth/yo
Authorization: Bearer {{login.response.body.token}}

### Iniciar sesión con la contraseña incorrecta
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
    "email": "admin@sportbook.com",
    "contrasena": "no-es-esta"
}

### Pedir un recurso sin token
GET http://localhost:3000/api/tipos-cancha


### Listar tipos de cancha
GET http://localhost:3000/api/tipos-cancha
Authorization: Bearer {{login.response.body.token}}

### Crear tipo de cancha
POST http://localhost:3000/api/tipos-cancha
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "nombre": "Fútbol 5",
    "descripcion": "Cancha de fútbol 5"
}


### Crear correctamente
POST http://localhost:3000/api/tipos-cancha
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "nombre": "Básquet",
    "descripcion": "Cancha de básquet"
}

### Crear sin nombre
POST http://localhost:3000/api/tipos-cancha
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "descripcion": "Cancha de básquet"
}

### Crear sin descripción
POST http://localhost:3000/api/tipos-cancha
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "nombre": "Básquet"
}

### Obtener tipo de cancha por ID
GET http://localhost:3000/api/tipos-cancha/6
Authorization: Bearer {{login.response.body.token}}

### Obtener tipo de cancha por ID inexistente
GET http://localhost:3000/api/tipos-cancha/999
Authorization: Bearer {{login.response.body.token}}

### Actualizar tipo de cancha
PUT http://localhost:3000/api/tipos-cancha/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "nombre": "Fútbol 7",
    "descripcion": "Cancha de fútbol 7"
}


### Actualizar tipo de cancha inexistente
PUT http://localhost:3000/api/tipos-cancha/999
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "nombre": "Fútbol 7",
    "descripcion": "Cancha de fútbol 7"
}

### Eliminar tipo de cancha
DELETE http://localhost:3000/api/tipos-cancha/3
Authorization: Bearer {{login.response.body.token}}


### Actualizar los datos del perfil propio
# Va sobre el usuario de la sesión, no sobre un :id. El rolId, el activo y la
# contraseña se descartan aunque vengan en el cuerpo.
PUT http://localhost:3000/api/auth/yo
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "nombre": "Nombre Corregido",
    "email": "corregido@sportbook.local",
    "telefono": "341 555-1111"
}

### Intentar ascenderse a ADMIN desde el perfil (el rolId se ignora)
PUT http://localhost:3000/api/auth/yo
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "nombre": "Nombre Corregido",
    "email": "corregido@sportbook.local",
    "telefono": "341 555-1111",
    "rolId": 1,
    "activo": false
}

### Cambiar la contraseña propia
PUT http://localhost:3000/api/auth/yo/contrasena
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "contrasenaActual": "admin1234",
    "contrasenaNueva": "claveNueva456"
}

### Cambiarla con la actual incorrecta (400, no 401)
PUT http://localhost:3000/api/auth/yo/contrasena
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "contrasenaActual": "no-es-esta",
    "contrasenaNueva": "claveNueva456"
}


##############################
# Reservas
##############################

### Listar todas las reservas
GET http://localhost:3000/api/reservas
Authorization: Bearer {{login.response.body.token}}

### Listar filtrando por cancha, día y estado
GET http://localhost:3000/api/reservas?canchaId=1&fecha=2026-08-20&estado=CONFIRMADA
Authorization: Bearer {{login.response.body.token}}

### Listar con un estado que no existe (400)
GET http://localhost:3000/api/reservas?estado=BASURA
Authorization: Bearer {{login.response.body.token}}

### Turnos libres de una cancha en un día (para elegir horarioId)
GET http://localhost:3000/api/horarios?canchaId=1&fecha=2026-08-20&disponible=true
Authorization: Bearer {{login.response.body.token}}

### Reservar un turno
# El cuerpo lleva solo el turno: la fecha, las horas, la cancha, el estado y el
# precio los deriva el backend. El `usuarioId` solo lo puede mandar un ADMIN, que
# reserva a nombre de otro; para un CLIENTE el dueño sale siempre de su sesión.
POST http://localhost:3000/api/reservas
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "horarioId": 1,
    "usuarioId": 1
}

### Reservar el mismo turno otra vez (409)
POST http://localhost:3000/api/reservas
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "horarioId": 1,
    "usuarioId": 1
}

### Obtener una reserva
GET http://localhost:3000/api/reservas/1
Authorization: Bearer {{login.response.body.token}}

### Reprogramar la reserva a otro turno libre
# Libera el turno anterior y copia del nuevo la fecha, las horas, la cancha y
# el precio total.
PUT http://localhost:3000/api/reservas/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "horarioId": 2
}

### Reprogramar al turno en el que ya está (400)
PUT http://localhost:3000/api/reservas/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "horarioId": 2
}

### Reprogramar a un turno inexistente (400)
PUT http://localhost:3000/api/reservas/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "horarioId": 9999
}

### Cancelar la reserva
# No borra la fila: la deja en CANCELADA y devuelve el turno a la lista de libres.
PUT http://localhost:3000/api/reservas/1/cancelar
Authorization: Bearer {{login.response.body.token}}

### Cancelar la misma reserva otra vez (409)
PUT http://localhost:3000/api/reservas/1/cancelar
Authorization: Bearer {{login.response.body.token}}

### Cancelar una reserva inexistente (404)
PUT http://localhost:3000/api/reservas/9999/cancelar
Authorization: Bearer {{login.response.body.token}}

##############################
# Eventos
##############################

### Listar todos los eventos
# Un ADMIN los ve todos; un CLIENTE, solo los de sus propias reservas.
GET http://localhost:3000/api/eventos
Authorization: Bearer {{login.response.body.token}}

### Listar el evento de una reserva
GET http://localhost:3000/api/eventos?reservaId=1
Authorization: Bearer {{login.response.body.token}}

### Listar con un reservaId que no es un número (400)
GET http://localhost:3000/api/eventos?reservaId=pepe
Authorization: Bearer {{login.response.body.token}}

### Cargarle el evento a una reserva
POST http://localhost:3000/api/eventos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "descripcion": "Cumpleaños de 15",
    "cantidadPersonas": 40,
    "tipoEventoId": 1,
    "reservaId": 1
}

### Cargarle un segundo evento a la misma reserva (409)
# Una reserva tiene a lo sumo un evento.
POST http://localhost:3000/api/eventos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "descripcion": "Otro festejo",
    "cantidadPersonas": 10,
    "tipoEventoId": 1,
    "reservaId": 1
}

### Crear con una cantidad de personas inválida (400)
POST http://localhost:3000/api/eventos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "descripcion": "Partido",
    "cantidadPersonas": 0,
    "tipoEventoId": 1,
    "reservaId": 2
}

### Crear con un tipo de evento que no existe (400)
POST http://localhost:3000/api/eventos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "descripcion": "Partido",
    "cantidadPersonas": 10,
    "tipoEventoId": 9999,
    "reservaId": 2
}

### Obtener un evento
GET http://localhost:3000/api/eventos/1
Authorization: Bearer {{login.response.body.token}}

### Modificar el evento
# El reservaId no entra: mover un evento de una reserva a otra no es una
# operación del negocio, así que si viene se ignora.
PUT http://localhost:3000/api/eventos/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "descripcion": "Cumpleaños de 18",
    "cantidadPersonas": 25,
    "tipoEventoId": 1
}

### Modificar un evento inexistente (404)
PUT http://localhost:3000/api/eventos/9999
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "descripcion": "Cumpleaños de 18",
    "cantidadPersonas": 25,
    "tipoEventoId": 1
}

### Eliminar un tipo de evento que tiene eventos asociados (409)
DELETE http://localhost:3000/api/tipos-evento/1
Authorization: Bearer {{login.response.body.token}}

### Eliminar el evento
DELETE http://localhost:3000/api/eventos/1
Authorization: Bearer {{login.response.body.token}}

##############################
# Pagos
##############################

### Listar todos los pagos
# Un ADMIN los ve todos; un CLIENTE, solo los de sus propias reservas.
GET http://localhost:3000/api/pagos
Authorization: Bearer {{login.response.body.token}}

### Listar los pagos de una reserva
GET http://localhost:3000/api/pagos?reservaId=1
Authorization: Bearer {{login.response.body.token}}

### Listar solo los anulados
GET http://localhost:3000/api/pagos?estado=ANULADO
Authorization: Bearer {{login.response.body.token}}

### Registrar una seña (pago parcial)
# La fecha y el estado los pone el servidor. La reserva sigue PENDIENTE porque
# lo pagado todavía no cubre el precio total.
POST http://localhost:3000/api/pagos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "reservaId": 1,
    "monto": 4000,
    "metodo": "EFECTIVO"
}

### Cobrar el resto: la reserva pasa a CONFIRMADA
POST http://localhost:3000/api/pagos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "reservaId": 1,
    "monto": 4000,
    "metodo": "TARJETA"
}

### Cobrar de más que el saldo (409)
POST http://localhost:3000/api/pagos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "reservaId": 1,
    "monto": 999999,
    "metodo": "EFECTIVO"
}

### Registrar con un método que no existe (400)
POST http://localhost:3000/api/pagos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "reservaId": 1,
    "monto": 1000,
    "metodo": "TRUEQUE"
}

### Obtener un pago
GET http://localhost:3000/api/pagos/1
Authorization: Bearer {{login.response.body.token}}

### Corregir el método con el que se cobró
# Es lo único editable: el monto se anula y se vuelve a registrar.
PUT http://localhost:3000/api/pagos/1
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "metodo": "TRANSFERENCIA"
}

### Anular el pago: la reserva vuelve a PENDIENTE
PUT http://localhost:3000/api/pagos/1/anular
Authorization: Bearer {{login.response.body.token}}

### Anularlo otra vez (409)
PUT http://localhost:3000/api/pagos/1/anular
Authorization: Bearer {{login.response.body.token}}
