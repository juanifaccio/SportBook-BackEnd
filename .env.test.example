# Configuración de los tests de integración. Copiar a `.env.test` y completar.
#
# Los tests de integración borran todas las tablas antes de cada suite, así que
# esta base tiene que ser una aparte de la de desarrollo. El nombre tiene que
# terminar en `_test`: es lo que comprueban `tests/apoyo/base.js` y
# `npm run test:preparar` antes de tocar nada.
#
# Con el archivo completo, correr una vez:
#   npm run test:preparar
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/sportsbook_test"

# Secreto con el que se firman los tokens durante los tests. No hace falta que
# sea el de desarrollo, pero sí que tenga al menos 32 caracteres.
JWT_SECRET="secreto-de-pruebas-de-al-menos-32-caracteres"
